# ==========================================
# TelegramPublisher Environment Configuration
# ==========================================

# Core Application & Networking
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=production
JWT_SECRET=change-this-to-a-secure-random-32-byte-secret

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_OWNER_ID=123456789

# Database Connection (Unified Single Connection String)
# SQLite (default):
DATABASE_URL=sqlite://data/publisher.db

# Or PostgreSQL:
# DATABASE_URL=postgres://postgres:password@localhost:5432/telegram_publisher?sslmode=disable

# Or MySQL / MariaDB:
# DATABASE_URL=mysql://publisher:password@localhost:3306/telegram_publisher?parseTime=true

# ---------------------------------------------------------------------------------------------
# NOTE: All dynamic operational settings are stored in the database 'settings' table and
# managed at runtime via the Admin Web Dashboard (/admin) without restarting the server:
#   - web_enabled, admin_web_enabled, bot_admin_enabled, mini_app_enabled, mini_app_url
#   - auto_delete_seconds (copyright TTL), copyright_warning_text, force_sub_enabled
#   - custom_buttons_json (default inline keyboard / buttons attached to messages in JSON format)
#   - azpays_enabled, azpays_api_key, azpays_secret_key, azpays_callback_url, azpays_success_url
# ---------------------------------------------------------------------------------------------


